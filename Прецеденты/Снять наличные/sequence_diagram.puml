@startuml
title Снятие наличных (backend)
actor Клиент as Client
participant ATMController as Controller
participant CashDispenser as Dispenser
participant BankingServiceClient as Banking
participant OperationJournal as Journal
participant ReceiptPrinter as Printer

Client -> Controller: Withdraw(session, amount)
Controller -> Dispenser: CanDispense(amount)
Dispenser --> Controller: canDispense

alt Нет нужной суммы в диспенсере
    Controller -> Journal: Add(WITHDRAWAL, Failed, "В банкомате нет нужной суммы")
    Controller --> Client: false
else
    Controller -> Banking: ExecuteWithdrawal(accountId, amount)
    Banking --> Controller: approved?

    alt Отклонено (баланс/лимит/сумма)
        Controller -> Journal: Add(WITHDRAWAL, Failed, "Отклонено банковской системой")
        Controller --> Client: false
    else Одобрено
        Controller -> Dispenser: TryDispense(amount)
        Dispenser --> Controller: dispensed?

        alt Выдано успешно
            Controller -> Journal: Add(WITHDRAWAL, Success, "Остаток: " + Dispenser.Remaining)
            opt Печать чека (внешний сценарий)
                Controller -> Printer: PrintReceipt("Withdraw " + amount)
            end
            Controller --> Client: true
        else Ошибка диспенсера
            Controller -> Journal: Add(WITHDRAWAL, Failed, "Ошибка диспенсера")
            Controller --> Client: false
        end
    end
end
@enduml

