@startuml
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam maxMessageSize 150

actor "Customer" as Customer
participant "Screen" as Screen
participant "Keypad" as Keypad
participant "CardReader" as CardReader
participant "ATMController" as Controller
participant "IBankingService" as Bank
participant "CashDispenser" as Dispenser
participant "ReceiptPrinter" as Printer
participant "MenuHandler" as Menu

' 1-3. Вставка карты
Customer -> CardReader: 1 Insert card
CardReader -> Controller: 2 ReadCard(cardData)
Controller -> Screen: 3 Request PIN (timeout 60s)

' Блок обработки таймаута ввода ПИН
alt Timeout (BR-SESSION-01)
    Controller -> Screen: 4 Session timeout
    Controller -> CardReader: 5 Eject card (Implied)
else Entered PIN
    Customer -> Controller: 6 Pin
    Controller -> Bank: 7 Authenticate(cardData, pin)
    
    ' Блок проверки авторизации
    alt Auth OK
        ' Успешная авторизация, переход к выбору действия
    else Auth failed
        break
            Controller -> Screen: 8 Wrong PIN
        end
    end
end

' Блок блокировки карты
alt Auth failed 3 times (BR-AUTH-02)
    Controller -> Screen: 9 Card blocked/retained
    Controller -> CardReader: 10 Retain card (Implied)
else Authenticated
    ' 11-12. Выбор действия через MenuHandler
    Controller -> Menu: 11 GetUserActionChoice()
    Menu --> Controller: 12 UserAction.Withdraw
    
    ' 13-14. Ввод суммы
    Controller -> Screen: 13 DisplayMessage("Введите сумму для снятия:")
    Controller -> Keypad: 14 GetInput(timeout=60s)
    activate Keypad
    
    ' Блок таймаута ввода суммы
    alt Timeout (BR-SESSION-01)
        Keypad --> Controller: 15 null (Timeout)
        Controller -> Screen: DisplayMessage("Таймаут ввода суммы. Возврат в меню.")
        deactivate Keypad
    else Entered amount
        Customer -> Keypad: Ввод суммы
        Keypad --> Controller: 16 amountStr
        deactivate Keypad
        
        Controller -> Controller: 17 TryParse(amountStr, out amount)
        
        alt Неверный формат суммы
            Controller -> Screen: DisplayMessage("Неверный формат суммы.")
        else Валидная сумма
            ' Блок проверки наличия денег в банкомате
            Controller -> Dispenser: 18 CanDispense(amount)
            activate Dispenser
            Dispenser --> Controller: 19 true/false
            deactivate Dispenser
            
            alt Not enough cash in ATM (BR-ATM-01)
                Controller -> Screen: 20 DisplayMessage("Недостаточно наличности в банкомате.")
            else ATM can dispense
                ' 21. Запрос к банковскому сервису
                Controller -> Bank: 21 ExecuteWithdrawal(accountId, amount)
                activate Bank
                
                ' Блок обработки ответа банка
                alt Declined: insufficient funds or daily limit (BR-LIMIT-01, BR-LIMIT-02)
                    Bank --> Controller: 22 false
                    Controller -> Screen: 23 DisplayMessage("Операция отклонена (баланс/лимит).")
                else Approved
                    Bank --> Controller: 24 true
                    deactivate Bank
                    
                    ' 25. Выдача денег
                    Controller -> Dispenser: 25 TryDispense(amount)
                    activate Dispenser
                    Dispenser --> Controller: 26 success
                    deactivate Dispenser
                    
                    ' 27. Печать чека (опционально)
                    opt Print receipt on request
                        Controller -> Screen: DisplayMessage("Печать чека? (y/n)")
                        Controller -> Keypad: GetInput(timeout=60s)
                        activate Keypad
                        Customer -> Keypad: Ввод "y"
                        Keypad --> Controller: "y"
                        deactivate Keypad
                        Controller -> Printer: 27 PrintReceipt("Withdrawn: " + amount + "; Remaining ATM cash: " + Dispenser.Remaining)
                    end
                end
            end
        end
    end
end

@enduml