@startuml
title Проверить баланс (backend)
actor Клиент as Client
participant ATMController as Controller
participant BankingServiceClient as Banking
participant OperationJournal as Journal
participant ReceiptPrinter as Printer

Client -> Controller: CheckBalance(session)
Controller -> Banking: GetBalance(accountId)
Banking --> Controller: balance
Controller -> Journal: Add(CHECK_BALANCE, Success, balance)
opt Печать чека (внешний сценарий)
    Controller -> Printer: PrintReceipt("Balance " + balance)
end
Controller --> Client: balance
@enduml

