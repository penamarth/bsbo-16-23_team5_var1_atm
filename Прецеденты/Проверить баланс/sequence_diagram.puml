@startuml
title Диаграмма последовательности: Проверка баланса (Check Balance)
autonumber

actor "Клиент" as Customer
participant Screen
participant Keypad
participant ATMController
participant IBankingService
participant ReceiptPrinter

' --- Предусловие: Клиент аутентифицирован ---

Customer -> Screen : Выбор "Проверить баланс"
Screen -> ATMController : UserAction.CheckBalance

' --- Основной поток: Запрос баланса ---
activate ATMController

    ATMController -> IBankingService : GetBalance(accountId)
    activate IBankingService
    
    else Успешный ответ
        IBankingService --> ATMController : balance (decimal)
        deactivate IBankingService
        
        ' --- Отображение баланса ---
        ATMController -> Screen : DisplayMessage("Текущий баланс: " + balance)
        
        ' --- Предложение печати чека ---
        ATMController -> Screen : DisplayMessage("Печать чека? (y/n)")
        ATMController -> Keypad : GetInput(timeout=60s)
        activate Keypad
        
        alt Таймаут ожидания ввода
            Keypad --> ATMController : null (Timeout)
            ATMController -> Screen : DisplayMessage("Таймаут. Возврат в меню")
        else Клиент отказался
            Customer -> Keypad : Ввод "n"
            Keypad --> ATMController : "n"
        else Клиент согласился
            Customer -> Keypad : Ввод "y"
            Keypad --> ATMController : "y"
            deactivate Keypad
            
            ' --- Печать чека ---
            ATMController -> ReceiptPrinter : PrintReceipt("Balance: " + balance)
            activate ReceiptPrinter
            ReceiptPrinter --> ATMController
            deactivate ReceiptPrinter
        end
        deactivate Keypad
    end

deactivate ATMController
@enduml