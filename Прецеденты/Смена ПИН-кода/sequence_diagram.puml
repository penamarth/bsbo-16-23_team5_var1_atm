@startuml
title Смена PIN (backend)
actor Клиент as Client
participant ATMController as Controller
participant BankingServiceClient as Banking
participant OperationJournal as Journal

Client -> Controller: ChangePin(cardData, oldPin, newPin)
Controller -> Banking: ChangePin(cardData, oldPin, newPin)
Banking --> Controller: success?

alt Успех
    Controller -> Journal: Add(CHANGE_PIN, Success)
    Controller --> Client: true
else Старый PIN не совпал
    Controller -> Journal: Add(CHANGE_PIN, Failed, "Смена PIN отклонена")
    Controller --> Client: false
end
@enduml

