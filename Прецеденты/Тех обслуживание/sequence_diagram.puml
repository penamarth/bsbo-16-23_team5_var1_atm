@startuml
title Техническое обслуживание (backend)
actor Инкассатор as Technician
participant MaintenanceController as Controller
participant CashDispenser as Dispenser
participant CashAcceptor as Acceptor
participant Logger as Log

Technician -> Controller: AuthenticateCollector(code)
Controller -> Controller: code == "9999" ?

alt Код верный
    Controller -> Log: "Инкассатор успешно аутентифицирован."

    opt Пополнить диспенсер
        Technician -> Controller: RefillDispenser(amount)
        Controller -> Dispenser: Refill(amount)
        Dispenser --> Controller
        Controller -> Log: "Диспенсер пополнен, остаток: " + Dispenser.Remaining
    end

    opt Инкассировать купюроприемник
        Technician -> Controller: CollectAcceptor()
        Controller -> Acceptor: CollectAllCash()
        Acceptor --> Controller: collected
        Controller -> Log: "Изъято " + collected
    end

    Technician -> Controller: CheckStatus()
    Controller -> Log: "Диспенсер: " + Dispenser.Remaining
    Controller -> Log: "Купюроприемник/Принтер/Кардридер: готов"
else Код неверный
    Controller -> Log: "Ошибка аутентификации инкассатора." (Warning)
end
@enduml

