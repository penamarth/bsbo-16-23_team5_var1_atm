@startuml
title Внесение наличных (backend)
actor Клиент as Client
participant ATMController as Controller
participant CashAcceptor as Acceptor
participant BankingServiceClient as Banking
participant OperationJournal as Journal
participant ReceiptPrinter as Printer

Client -> Controller: Deposit(session, amount, cashAlreadyAccepted)
Controller -> Controller: amount > 0 ?
alt amount <= 0
    Controller -> Journal: Add(DEPOSIT, Failed)
    Controller --> Client: false
else amount > 0
    opt cashAlreadyAccepted == false
        Controller -> Acceptor: AcceptCash(amount)
        Acceptor --> Controller: acceptedAmount
    end

    Controller -> Banking: Deposit(accountId, amount)
    Banking --> Controller: success?

    alt Ошибка зачисления
        Controller -> Acceptor: EjectCash()
        Controller -> Journal: Add(DEPOSIT, Failed)
        Controller --> Client: false
    else Успех
        Controller -> Journal: Add(DEPOSIT, Success)
        opt Печать чека (внешний сценарий)
            Controller -> Printer: PrintReceipt("Deposit " + amount)
        end
        Controller --> Client: true
    end
end
@enduml

